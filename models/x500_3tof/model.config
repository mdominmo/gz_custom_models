<?xml version="1.0"?>
<model>
  <name>x500_3tof</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Manuel Dominguez</name>
    <email>mandominguez97@gmail.com</email>
  </author>
  <description>
    An x500 quadcopter with 3 forward-looking single-beam ToF rangefinders
    (nose and +-20 deg) for nose-forward obstacle avoidance. Each beam is a
    3 deg, 5-ray gpu_lidar cone with gaussian noise (TFmini-class sensor).
  </description>
</model>
