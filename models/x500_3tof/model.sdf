<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <!-- x500 with three forward-looking single-beam ToF rangefinders: nose
       (0 deg) and +-20 deg. Each beam is modelled as a 3 deg cone (5 rays,
       the consumer keeps the closest return) with 2 cm gaussian noise, to
       approximate a TFmini-class sensor rather than an ideal ray. The +-20
       deg sensors sit 5 cm off the centreline on the front edge; their
       beams diverge from the arms and stay below the propeller plane. -->
  <model name='x500_3tof'>
    <include merge='true'>
      <uri>x500</uri>
    </include>

    <!-- ======================== -->
    <!-- FRONT (0 deg) -->
    <!-- ======================== -->
    <link name="rangefinder_front_link">
      <pose relative_to="base_link">0.15 0 0.01 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.000004</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000004</iyy>
          <iyz>0</iyz>
          <izz>0.000002</izz>
        </inertia>
      </inertial>
      <visual name="rangefinder_front_visual">
        <geometry>
          <box>
            <size>0.03 0.02 0.043</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      <collision name="rangefinder_front_collision">
        <geometry>
          <box>
            <size>0.03 0.02 0.043</size>
          </box>
        </geometry>
      </collision>
      <sensor name="rangefinder_front" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.026180</min_angle>
              <max_angle>0.026180</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>5.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="rangefinder_front_joint" type="fixed">
      <parent>base_link</parent>
      <child>rangefinder_front_link</child>
    </joint>

    <!-- ======================== -->
    <!-- FRONT-LEFT (+20 deg) -->
    <!-- ======================== -->
    <link name="rangefinder_front_left_link">
      <pose relative_to="base_link">0.15 0.05 0.01 0 0 0.349066</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.000004</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000004</iyy>
          <iyz>0</iyz>
          <izz>0.000002</izz>
        </inertia>
      </inertial>
      <visual name="rangefinder_front_left_visual">
        <geometry>
          <box>
            <size>0.03 0.02 0.043</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      <collision name="rangefinder_front_left_collision">
        <geometry>
          <box>
            <size>0.03 0.02 0.043</size>
          </box>
        </geometry>
      </collision>
      <sensor name="rangefinder_front_left" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.026180</min_angle>
              <max_angle>0.026180</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>5.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="rangefinder_front_left_joint" type="fixed">
      <parent>base_link</parent>
      <child>rangefinder_front_left_link</child>
    </joint>

    <!-- ======================== -->
    <!-- FRONT-RIGHT (-20 deg) -->
    <!-- ======================== -->
    <link name="rangefinder_front_right_link">
      <pose relative_to="base_link">0.15 -0.05 0.01 0 0 -0.349066</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.000004</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000004</iyy>
          <iyz>0</iyz>
          <izz>0.000002</izz>
        </inertia>
      </inertial>
      <visual name="rangefinder_front_right_visual">
        <geometry>
          <box>
            <size>0.03 0.02 0.043</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      <collision name="rangefinder_front_right_collision">
        <geometry>
          <box>
            <size>0.03 0.02 0.043</size>
          </box>
        </geometry>
      </collision>
      <sensor name="rangefinder_front_right" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.026180</min_angle>
              <max_angle>0.026180</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>5.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="rangefinder_front_right_joint" type="fixed">
      <parent>base_link</parent>
      <child>rangefinder_front_right_link</child>
    </joint>

  </model>
</sdf>
